<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <WindowsSdkPackageVersion>10.0.17763.38</WindowsSdkPackageVersion>
        <ApplicationIcon>WindowIcon.ico</ApplicationIcon>
        <PackageIcon>logo_128.png</PackageIcon>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!-- Platform detection: prefer RuntimeIdentifier, fall back to host OS -->
    <PropertyGroup Condition=" '$(RuntimeIdentifier)' != '' ">
        <VrcftTargetOS Condition="$(RuntimeIdentifier.StartsWith('win'))">WINDOWS</VrcftTargetOS>
        <VrcftTargetOS Condition="$(RuntimeIdentifier.StartsWith('linux'))">LINUX</VrcftTargetOS>
        <VrcftTargetOS Condition="$(RuntimeIdentifier.StartsWith('osx'))">MACOS</VrcftTargetOS>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(VrcftTargetOS)' == '' ">
        <VrcftTargetOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">WINDOWS</VrcftTargetOS>
        <VrcftTargetOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">LINUX</VrcftTargetOS>
        <VrcftTargetOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">MACOS</VrcftTargetOS>
    </PropertyGroup>

    <!-- Per-Configuration Defines -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>$(DefineConstants);TRACE;$(VrcftTargetOS);DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants>$(DefineConstants);TRACE;$(VrcftTargetOS)</DefineConstants>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <!-- Packages -->
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.2.3"/>
        <PackageReference Include="Velopack" Version="0.0.1298"/>
        <PackageReference Update="Packaging.Targets">
            <Version>0.1.232</Version>
        </PackageReference>
    </ItemGroup>

    <!-- Platform Specific -->

    <!-- Shared -->
    <ItemGroup>
        <ProjectReference Include="..\VRCFaceTracking.Avalonia\VRCFaceTracking.Avalonia.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="VRCFT-logo_128.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="WindowIcon.ico"/>
    </ItemGroup>
</Project>
